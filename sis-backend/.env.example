DB_URL=jdbc:mysql://localhost:3306/smart_inventory_db
DB_USER=root
DB_PASSWORD=replace-with-your-local-database-password

# Use a cryptographically random value of at least 32 bytes.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=smart-inventory-backend
JWT_AUDIENCE=smart-inventory-client

TEMP_PASSWORD_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=30

# Required before admin account creation can send temporary passwords.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=